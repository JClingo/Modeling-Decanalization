# Track only paper sources, figures, and submission materials.
# Implementation, experiments, editor settings, and build output stay local.
/*
!/.gitignore
!/*.tex
!/figures/
!/reviews/
!/archive/

# LaTeX build output and local metadata (including inside figures/)
.DS_Store
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
!/figures/*.pdf
*.run.xml
*.synctex.gz
