# Track only paper sources, figures, and submission materials.
# Implementation, experiments, reviews, editor settings, and build output stay local.
/*
!/.gitignore
!/*.tex
!/cover-letter-statement
!/figures/

# LaTeX build output and local metadata (including inside figures/)
.DS_Store
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.pdf
*.run.xml
*.synctex.gz
